<%- include('../partials/header') %><div class="d-flex justify-content-between align-items-end mb-4"><div><p class="eyebrow mb-1">ELENCO</p><h1 class="h2">Minhas equipes</h1></div><a href="/teams/new" class="btn btn-primary" data-testid="create-team">Criar equipe</a></div><div class="row g-3"><% if(!teams.length){ %><div class="empty-state">Você ainda não possui equipes.</div><% } %><% teams.forEach(t=>{ %><div class="col-md-6"><div class="card h-100"><div class="card-body"><h2 class="h5"><%= t.name %></h2><p class="mb-1">Capitão: <strong><%= t.captain %></strong></p><p class="text-muted"><%= t.players %> jogadores</p><div class="d-flex gap-2"><a class="btn btn-sm btn-outline-primary" href="/teams/<%= t.id %>/edit">Editar</a><form method="post" action="/teams/<%= t.id %>/delete"><button class="btn btn-sm btn-outline-danger">Excluir</button></form></div></div></div></div><% }) %></div><%- include('../partials/footer') %>
