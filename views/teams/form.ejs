<%- include('../partials/header') %><div class="form-page card"><div class="card-body p-4 p-md-5"><p class="eyebrow">EQUIPE</p><h1 class="h3 mb-4"><%= team ? 'Editar equipe' : 'Criar equipe' %></h1><form method="post" action="<%= team ? '/teams/'+team.id+'/edit' : '/teams' %>"><div class="row g-3"><div class="col-md-6"><label class="form-label">Nome da equipe *</label><input class="form-control" name="name" required value="<%= team?.name || '' %>" data-testid="team-name"></div><div class="col-md-6"><label class="form-label">Capitão *</label><input class="form-control" name="captain" required value="<%= team?.captain || '' %>"></div><div class="col-md-6"><label class="form-label">Quantidade de jogadores *</label><input class="form-control" type="number" min="1" name="players" required value="<%= team?.players || '' %>"></div></div><div class="mt-4"><button class="btn btn-primary" data-testid="team-submit">Salvar equipe</button></div></form></div></div><%- include('../partials/footer') %>
