<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · ArenaCup</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"><link href="/css/style.css" rel="stylesheet"></head><body><nav class="navbar navbar-expand-lg navbar-dark ac-nav"><div class="container"><a class="navbar-brand fw-bold" href="/" data-testid="brand"><i class="bi bi-trophy-fill"></i> ArenaCup</a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="menu"><ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2"><li class="nav-item"><a class="nav-link" href="/tournaments">Torneios</a></li><% if (currentUser) { %><li class="nav-item"><a class="nav-link" href="/dashboard">Meu painel</a></li><li class="nav-item"><form action="/logout" method="post"><button class="btn btn-sm btn-outline-light" data-testid="logout">Sair</button></form></li><% } else { %><li class="nav-item"><a class="nav-link" href="/login">Entrar</a></li><li class="nav-item"><a class="btn btn-primary btn-sm" href="/register">Cadastrar</a></li><% } %></ul></div></div></nav><main class="container py-4 py-lg-5"><% if (flash) { %><div class="alert alert-<%= flash.type %> alert-dismissible fade show" role="alert" data-testid="flash-message"><%= flash.text %><button class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
