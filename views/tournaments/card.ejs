<div class="card tournament-card h-100"><div class="card-body"><div class="d-flex justify-content-between gap-2 mb-3"><span class="badge <%= status(tournament)==='Encerrado'?'text-bg-secondary':status(tournament)==='Em andamento'?'text-bg-success':'text-bg-warning' %>"><%= status(tournament) %></span><span class="text-muted small"><i class="bi bi-geo-alt"></i> <%= tournament.location %></span></div><h3 class="h5"><%= tournament.name %></h3><p class="text-primary fw-medium mb-2"><%= tournament.modality %></p><small class="text-muted d-block mb-3"><i class="bi bi-calendar3"></i> <%= tournament.startDate %> — <%= tournament.endDate %></small><a class="stretched-link" href="/tournaments/<%= tournament.id %>"><span class="visually-hidden">Abrir <%= tournament.name %></span></a></div></div>
