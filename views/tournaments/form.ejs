<%- include('../partials/header') %><div class="form-page card"><div class="card-body p-4 p-md-5"><p class="eyebrow"><%= tournament ? 'CONFIGURAÇÃO' : 'NOVA COMPETIÇÃO' %></p><h1 class="h3 mb-4"><%= tournament ? 'Editar torneio' : 'Criar torneio' %></h1><form method="post" action="<%= tournament ? '/tournaments/'+tournament.id+'/edit' : '/tournaments' %>"><div class="row g-3"><div class="col-md-8"><label class="form-label">Nome do torneio *</label><input class="form-control" name="name" required value="<%= tournament?.name || '' %>" data-testid="tournament-name"></div><div class="col-md-4"><label class="form-label">Modalidade *</label><select class="form-select" name="modality" required data-testid="tournament-modality"><option value="">Selecione</option><% ['Futebol','Vôlei','Basquete'].forEach(m=>{ %><option <%= tournament?.modality===m?'selected':'' %>><%= m %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Data de início *</label><input class="form-control" type="date" name="startDate" required value="<%= tournament?.startDate || '' %>"></div><div class="col-md-4"><label class="form-label">Data de término *</label><input class="form-control" type="date" name="endDate" required value="<%= tournament?.endDate || '' %>"></div><div class="col-md-4"><label class="form-label">Máximo de equipes *</label><input class="form-control" type="number" min="1" name="maxTeams" required value="<%= tournament?.maxTeams || '' %>"></div><div class="col-12"><label class="form-label">Local *</label><input class="form-control" name="location" required value="<%= tournament?.location || '' %>"></div></div><div class="mt-4 d-flex gap-2"><button class="btn btn-primary" data-testid="tournament-submit">Salvar torneio</button><a href="/dashboard" class="btn btn-light">Cancelar</a></div></form></div></div><%- include('../partials/footer') %>
