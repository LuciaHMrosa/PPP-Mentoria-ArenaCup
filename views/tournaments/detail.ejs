<%- include('../partials/header') %>
<section class="detail-hero rounded-4 p-4 p-md-5 mb-4"><div class="d-flex justify-content-between flex-wrap gap-3"><div><span class="badge <%= status(tournament)==='Encerrado'?'text-bg-secondary':status(tournament)==='Em andamento'?'text-bg-success':'text-bg-warning' %>"><%= status(tournament) %></span><h1 class="mt-2"><%= tournament.name %></h1><p class="mb-0"><%= tournament.modality %> · <%= tournament.location %> · <%= tournament.startDate %> a <%= tournament.endDate %></p></div><% if(currentUser?.role==='organizer' && tournament.organizerId===currentUser.id){ %><div class="d-flex gap-2"><a class="btn btn-light" href="/tournaments/<%= tournament.id %>/edit">Editar</a><form method="post" action="/tournaments/<%= tournament.id %>/close"><button class="btn btn-outline-light">Encerrar</button></form></div><% } %></div></section>
<% if(currentUser?.role==='participant' && status(tournament)==='Planejado'){ %><section class="card mb-4"><div class="card-body"><h2 class="h5">Inscrever equipe</h2><form method="post" action="/tournaments/<%= tournament.id %>/register" class="row g-2"><div class="col-md-8"><select class="form-select" name="teamId" required><option value="">Selecione uma das suas equipes</option><% ownTeams.forEach(team=>{ %><option value="<%= team.id %>"><%= team.name %></option><% }) %></select></div><div class="col-md-4"><button class="btn btn-primary w-100" data-testid="registration-submit">Solicitar inscrição</button></div></form></div></section><% } %>
<% if(currentUser?.role==='organizer' && tournament.organizerId===currentUser.id){ %><section class="card mb-4"><div class="card-body d-flex gap-3 align-items-center"><strong>Gerenciamento</strong><form method="post" action="/tournaments/<%= tournament.id %>/matches"><button class="btn btn-primary btn-sm" data-testid="generate-matches">Gerar partidas</button></form></div></section><% } %>
<div class="row g-4"><div class="col-lg-7"><section class="card"><div class="card-body"><h2 class="h4">Partidas</h2><% if(!matches.length){ %><p class="text-muted">As partidas ainda não foram geradas.</p><% } %><% matches.forEach(m=>{ %><div class="match-row py-3 border-bottom"><div><small class="text-muted">Rodada <%= m.round %> · <%= m.date %> · <%= m.time %></small><div class="fw-semibold"><%= m.teamA.name %> <span class="score"><%= m.scoreA ?? '—' %> × <%= m.scoreB ?? '—' %></span> <%= m.teamB.name %></div></div><% if(currentUser?.role==='organizer' && tournament.organizerId===currentUser.id){ %><form method="post" action="/matches/<%= m.id %>/result" class="result-form"><input type="number" min="0" name="scoreA" value="<%= m.scoreA ?? '' %>" required><span>×</span><input type="number" min="0" name="scoreB" value="<%= m.scoreB ?? '' %>" required><button class="btn btn-sm btn-primary" data-testid="register-result">Salvar</button></form><% } %></div><% }) %></div></section></div><div class="col-lg-5"><section class="card mb-4"><div class="card-body"><h2 class="h4">Equipes aprovadas</h2><ul class="list-group list-group-flush"><% registrations.filter(r=>r.status==='approved').forEach(r=>{ %><li class="list-group-item px-0"><%= r.team.name %></li><% }) %><% if(!registrations.some(r=>r.status==='approved')){ %><li class="list-group-item px-0 text-muted">Nenhuma equipe aprovada.</li><% } %></ul></div></section><section class="card"><div class="card-body"><h2 class="h4">Classificação</h2><div class="table-responsive"><table class="table table-sm" data-testid="standings-table"><thead><tr><th>#</th><th>Equipe</th><th>J</th><th>V</th><th>E</th><th>D</th><th>Pts</th><th>Saldo</th></tr></thead><tbody><% standings.forEach(s=>{ %><tr><td><%= s.position %></td><td><%= s.team.name %></td><td><%= s.played %></td><td><%= s.wins %></td><td><%= s.draws %></td><td><%= s.losses %></td><td class="fw-bold"><%= s.points %></td><td><%= s.balance %></td></tr><% }) %></tbody></table></div></div></section></div></div>
<% if(currentUser?.role==='organizer' && tournament.organizerId===currentUser.id){ %><section class="card mt-4"><div class="card-body"><h2 class="h5">Inscrições</h2><% registrations.forEach(r=>{ %><div class="d-flex justify-content-between align-items-center border-top py-2"><span><%= r.team.name %> <span class="badge text-bg-<%= r.status==='approved'?'success':r.status==='rejected'?'danger':'warning' %>"><%= r.status==='pending'?'Pendente':r.status==='approved'?'Aprovada':'Recusada' %></span></span><% if(r.status==='pending'){ %><span class="d-flex gap-1"><form method="post" action="/registrations/<%= r.id %>/approve"><button class="btn btn-success btn-sm" data-testid="approve-registration">Aprovar</button></form><form method="post" action="/registrations/<%= r.id %>/reject"><button class="btn btn-outline-danger btn-sm">Recusar</button></form></span><% } %></div><% }) %></div></section><% } %>
<%- include('../partials/footer') %>
