<%- include('../partials/header') %><div class="d-flex justify-content-between align-items-end mb-4"><div><p class="eyebrow mb-1">MEU PAINEL</p><h1 class="h2">Olá, <%= currentUser.name %></h1></div><a href="/teams/new" class="btn btn-primary" data-testid="create-team"><i class="bi bi-plus-lg"></i> Criar equipe</a></div><div class="row g-3 mb-5"><% [[teams.length,'Minhas equipes','bi-people'],[registrations.length,'Inscrições','bi-clipboard-check'],[tournaments.length,'Torneios abertos','bi-trophy']].forEach(x=>{ %><div class="col-md-4"><div class="stat-card"><i class="bi <%= x[2] %>"></i><strong><%= x[0] %></strong><span><%= x[1] %></span></div></div><% }) %></div><div class="d-flex justify-content-between"><h2 class="h4">Minhas equipes</h2><a href="/teams">Gerenciar equipes</a></div><div class="row g-3"><% if(!teams.length){ %><div class="empty-state">Crie uma equipe para começar a competir.</div><% } %><% teams.forEach(t=>{ %><div class="col-md-6"><div class="card h-100"><div class="card-body"><h3 class="h5"><%= t.name %></h3><p class="mb-1">Capitão: <%= t.captain %></p><small class="text-muted"><%= t.players %> jogadores</small></div></div></div><% }) %></div><%- include('../partials/footer') %>
