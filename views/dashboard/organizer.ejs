<%- include('../partials/header') %><div class="d-flex justify-content-between align-items-end mb-4"><div><p class="eyebrow mb-1">PAINEL</p><h1 class="h2">Olá, <%= currentUser.name %></h1></div><a href="/tournaments/new" class="btn btn-primary" data-testid="create-tournament"><i class="bi bi-plus-lg"></i> Criar torneio</a></div><div class="row g-3 mb-5"><% [[tournaments.length,'Torneios','bi-trophy'],[pending.length,'Inscrições pendentes','bi-hourglass-split'],[matches.length,'Partidas','bi-calendar-event']].forEach(x=>{ %><div class="col-md-4"><div class="stat-card"><i class="bi <%= x[2] %>"></i><strong><%= x[0] %></strong><span><%= x[1] %></span></div></div><% }) %></div><h2 class="h4 mb-3">Meus torneios</h2><div class="row g-3"><% if(!tournaments.length){ %><div class="empty-state">Você ainda não criou torneios.</div><% } %><% tournaments.forEach(t=>{ %><div class="col-md-6"><%- include('../tournaments/card',{tournament:t}) %></div><% }) %></div><%- include('../partials/footer') %>
